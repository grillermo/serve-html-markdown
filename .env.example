SLACK_FAILURE_WEBHOOK=
# Permanent store for downloaded videos; defaults to <app>/videos
VIDEOS_DIR=

# Background jobs (Solid Queue)
SOLID_QUEUE_IN_PUMA=true
JOB_CONCURRENCY=1

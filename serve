#!/usr/bin/env bash
# (Re)start serve-html-markdown in tmux session "serve-html-markdown", in
# place, and return: one pane runs the Go server and its job workers.
# Run by ../server/after-reboot.sh at boot and by ./activate after git-sync
# lands new code.
set -euo pipefail
# after-reboot.sh does not run under a login shell; go and tmux live in Homebrew,
# and the claude CLI (the expansions' first provider) in ~/.local/bin.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
APP_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_DIR"
export SESSION=serve-html-markdown
# shellcheck source=/dev/null
. "$HOME/c/server/serve-in-place.sh"

# Every subcommand below (migrate and the server) appends what it logs to
# this file as well as printing it; it rotates to .1 past 50 MB.
export LOG_FILE="$APP_DIR/log/production.log"

mkdir -p tmp log
echo "==> go build"; go build -o tmp/serve-html-markdown ./cmd/serve-html-markdown
# Migrations take a session (advisory lock, multi-statement DDL), so they go
# straight to Postgres on 5432, not through PgBouncer.
echo "==> migrate";  tmp/serve-html-markdown migrate

# The web pane goes through PgBouncer (transaction mode), so no prepared
# statements. SIGTERM stops the listener (30 s) and then lets running jobs finish.
serve_pane web 8009 "env LOG_FILE=$LOG_FILE DATABASE_PORT=6432 DATABASE_PREPARED_STATEMENTS=false DATABASE_POOL=12 tmp/serve-html-markdown serve"
serve_attach
